<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ZKTecoC3Manager</RootNamespace>
    <AssemblyName>ZKTecoC3Manager</AssemblyName>
    <!-- PullSDK (plcommpro.dll) phổ biến là bản 32-bit, nên build x86.
         Nếu dùng bản PullSDK 64-bit thì đổi thành x64. -->
    <PlatformTarget>x86</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- MainForm.Layout.cs là phần dựng giao diện bằng code của MainForm, không phải form riêng:
       không mở bằng Designer và không nhúng resx riêng (tránh trùng ZKTecoC3Manager.MainForm.resources). -->
  <ItemGroup>
    <Compile Update="MainForm.Layout.cs">
      <SubType>Code</SubType>
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Remove="MainForm.Layout.resx" />
  </ItemGroup>

  <!-- Mọi DLL trong ZKTecoSDK\ (PullSDK + QRCoder.dll) được copy ra cạnh exe khi build (bin\...)
       và khi publish. Thêm/thay DLL chỉ cần chép vào ZKTecoSDK\ rồi build lại. -->
  <ItemGroup>
    <None Include="ZKTecoSDK\*.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Báo ngay lúc build nếu thiếu plcommpro.dll, thay vì đợi DllNotFoundException khi bấm Kết nối. -->
  <Target Name="CheckPullSdkDlls" AfterTargets="Build">
    <Warning Condition="!Exists('$(OutDir)plcommpro.dll')"
             Text="Không thấy plcommpro.dll trong $(OutDir). Hãy chép bộ DLL PullSDK vào ZKTecoSDK\ rồi build lại." />
  </Target>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
